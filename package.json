{
  "name": "briefing",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "^26.0.0"
  },
  "scripts": {
    "migrate": "tsx --env-file=.env src/entrypoints/migrate/index.ts | pino-pretty --messageKey message",
    "sync": "tsx --env-file=.env src/entrypoints/sync/index.ts | pino-pretty --messageKey message",
    "dev": "concurrently \"npm run dev:web\" \"npm run dev:browser\"",
    "dev:web": "tsx --env-file=.env --watch --inspect src/entrypoints/web/index.ts | pino-pretty --messageKey message",
    "dev:browser": "esbuild browser/index.ts --bundle --format=esm --target=es2022 --sourcemap --watch --outfile=public/assets/app.js",
    "build": "rm -fr dist && npm run build:web && npm run build:browser",
    "build:web": "tsc -p tsconfig.build.json",
    "build:browser": "esbuild browser/index.ts --bundle --format=esm --target=es2022 --minify --outfile=public/assets/app.js",
    "typecheck": "npm run typecheck:web && npm run typecheck:browser",
    "typecheck:web": "tsc -p tsconfig.build.json --noEmit",
    "typecheck:browser": "tsc -p browser/tsconfig.json",
    "lint": "eslint .",
    "format": "prettier . --write"
  },
  "dependencies": {
    "bootstrap": "^5.3.8",
    "express": "^5.2.1",
    "html-to-text": "^10.0.1",
    "morphdom": "^2.7.8",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/html-to-text": "^9.0.4",
    "@types/node": "^26.4.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "concurrently": "^10.0.5",
    "eslint": "^10.9.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0"
  }
}
