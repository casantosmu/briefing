{
  "name": "briefing",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "^26.0.0"
  },
  "scripts": {
    "dev": "tsx --env-file=.env --watch --inspect src/index.ts | pino-pretty --messageKey message",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier . --write"
  },
  "dependencies": {
    "express": "^5.2.1",
    "pino": "^10.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "eslint": "^10.9.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0"
  }
}
